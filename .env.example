# Copy this file to ".env" and fill in at least one key. Never commit ".env".

# Free key: https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=

# Optional backup brain. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: default city for "weather" (example: Mumbai)
JARVIS_CITY=

# Optional: lets "play <song name>" find and start songs automatically.
# Free: https://developer.spotify.com/dashboard -> Create app (Redirect URI: http://127.0.0.1:8888/callback)
# then copy the Client ID and Client secret here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: override the models (check each provider's docs for current names)
# JARVIS_GEMINI_MODEL=gemini-flash-latest
# JARVIS_GROQ_MODEL=openai/gpt-oss-120b
